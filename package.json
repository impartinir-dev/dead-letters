{
  "name": "dead-letters",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DEAD LETTERS — a murder mystery word search casebook. 150 cases.",
  "scripts": {
    "dev": "vite",
    "generate": "tsx scripts/generate-cases.ts",
    "icons": "tsx scripts/make-icons.ts",
    "prebuild": "npm run generate",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
